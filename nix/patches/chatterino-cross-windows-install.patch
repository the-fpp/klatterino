@@ -1206 +1206,8 @@ if (BUILD_APP)
-    elseif (APPLE)
+    elseif (WIN32)
+        # A non-Windows build host cannot execute windeployqt or CMake's
+        # RUNTIME_DEPENDENCIES scanner for a PE target. The packaging
