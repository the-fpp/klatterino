rumble_usercard_smoke()
{
    local main
    main="$(main_window || true)"
    [[ -n "$main" ]] || fail "the Chatterino main window was not found"
    sleep 0.75

    shot_window rumble-usercard-fixture "$main"
    local coordinates text_x text_y text_width text_height click_x click_y
    coordinates="$(
        tesseract "$LAST_FULL" stdout --psm 6 tsv 2>/dev/null |
            awk -F '\t' '
                tolower($12) ~ /^synthetic/ {
                    print $7, $8, $9, $10,
                          int($7 + ($9 / 2)), int($8 + ($10 / 2));
                    exit
                }'
    )"
    read -r text_x text_y text_width text_height click_x click_y <<<"$coordinates"
    [[ "$text_x" =~ ^[0-9]+$ && "$text_y" =~ ^[0-9]+$ &&
       "$text_width" =~ ^[1-9][0-9]*$ &&
       "$text_height" =~ ^[1-9][0-9]*$ &&
       "$click_x" =~ ^[0-9]+$ && "$click_y" =~ ^[0-9]+$ ]] ||
        fail "the synthetic Rumble author was not rendered"

    local color_means mean_green mean_blue username_paint=foreign
    color_means="$(
        magick "$LAST_FULL" \
            -crop "${text_width}x${text_height}+${text_x}+${text_y}" \
            -colorspace RGB \
            -format '%[fx:mean.g] %[fx:mean.b]' info:
    )"
    read -r mean_green mean_blue <<<"$color_means"
    if awk -v green="$mean_green" -v blue="$mean_blue" \
        'BEGIN { exit !(green > blue) }'; then
        username_paint=rumble-native
    fi

    inner xdotool mousemove --sync --window "$main" "$click_x" "$click_y"
    inner xdotool click --window "$main" 1

    local popup
    popup="$(wait_for_window --name '^Synthetic Rumble.*Usercard' 200 || true)"
    [[ -n "$popup" ]] || fail "the synthetic Rumble usercard did not open"
    sleep 0.2
    shot_window rumble-usercard "$popup"

    local ocr lower fields=missing foreign_controls=present
    ocr="$(tesseract "$LAST_FULL" stdout --psm 6 2>/dev/null || true)"
    lower="${ocr,,}"
    if [[ "$lower" == *"rumble"* &&
          "$lower" == *"synthetic rumble"* &&
          "$lower" == *"synthetic-rumble"* &&
          "$lower" == *"roles: moderator"* &&
          "$lower" == *"badges: verified"* &&
          "$lower" == *"recurring subscription"* ]]; then
        fields=exact
    fi
    if [[ "$lower" != *"followers:"* &&
          "$lower" != *"created:"* &&
          "$lower" != *"pronouns:"* &&
          "$lower" != *"ignore highlights"* &&
          "$lower" != *"add notes"* &&
          "$lower" != *"timeouts"* &&
          "$lower" != *"open 7tv"* &&
          "$lower" != *"twitch.tv"* &&
          "$lower" != *"kick.com"* ]]; then
        foreign_controls=absent
    fi

    note "rumble-usercard=opened fields=${fields} foreign-controls=${foreign_controls} username-paint=${username_paint}"
    [[ "$fields" == exact && "$foreign_controls" == absent &&
       "$username_paint" == rumble-native ]]
}

