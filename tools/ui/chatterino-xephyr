#!/usr/bin/env bash
set -euo pipefail

usage()
{
    cat <<'EOF'
Usage: chatterino-ui-xephyr [--session NAME] COMMAND [OPTIONS]

Run and control Chatterino in an authenticated Xephyr display.

Commands:
  doctor                    Check the host display and required programs.
  start [OPTIONS]           Start Xephyr, Openbox, and Chatterino.
  status                    Report process and nested-display state.
  env                       Print shell exports for the nested display.
  windows                   List visible windows in the nested display.
  accounts-open             Open Settings > Accounts in the running session.
  account-add-open          Open the shared Add Account dialog.
  rumble-account-tab-open  Open Add Account > Rumble and prepare login.
  rumble-open LOCATOR       Open a public Rumble channel in the active split.
  rumble-status             Run /rumble-status and inspect fixed status fields.
  rumble-login-open         Open the native Rumble login browser.
  rumble-login-smoke        Launch/cancel login in the running session.
  rumble-smoke LOCATOR      Open a Rumble channel, then inspect its status.
  rumble-smoke-once LOCATOR [START OPTIONS]
                            Start, smoke, and always stop an ephemeral session.
  rumble-usercard-smoke     Check a synthetic Rumble usercard in the app.
  rumble-usercard-smoke-once [START OPTIONS]
                            Start, check the synthetic card, and always stop.
  rumble-reply-smoke        Send a synthetic Rumble reply fallback in the app.
  rumble-reply-smoke-once [START OPTIONS]
                            Start, send the synthetic reply, and always stop.
  rumble-lifecycle-smoke    Check synthetic live/end/restore state in the app.
  rumble-lifecycle-smoke-once [START OPTIONS]
                            Start, check lifecycle state, and always stop.
  automatic-routing-smoke Check synthetic offline-first automatic routing.
  automatic-routing-smoke-once [START OPTIONS]
                            Start, check routing, and always stop.
  compact-tab-reveal-smoke Check revealed tab/add/picker interaction.
  compact-tab-reveal-smoke-once [START OPTIONS]
                            Start, check compact reveal, and always stop.
  control-tab-smoke         Exercise declarative plugin controls in the app.
  control-tab-smoke-once [START OPTIONS]
                            Start, check control tabs, and always stop.
  rumble-login-smoke-once [START OPTIONS]
                            Launch/cancel the login browser and verify cleanup.
  rumble-login-live-once [START OPTIONS]
                            Wait for a real login and verify the live session.
  shot [NAME] [WINDOW]      Save a full PNG and an 800px WebP preview.
  stop                      Stop this session without deleting its profile.

Start options:
  --chatterino PATH         Chatterino executable (default: packaged binary).
  --rumble-login-helper PATH
                            Use the legacy bounded test-protocol override.
  --selenium-manager PATH  Selenium Manager executable for local app builds.
  --qt-plugin-path PATH    Extra Qt plugins for an unwrapped local app build.
  --qt-scale-factor 1|2    Force the tested application scale factor.
  --rumble-usercard-fixture
                            Inject the fixed offline usercard test message.
  --rumble-reply-fixture    Prepare the fixed offline Rumble reply draft.
  --rumble-lifecycle-fixture
                            Drive fixed live/backoff/offline/restore states.
  --automatic-routing-fixture
                            Drive fixed offline/live automatic routing states.
  --compact-tab-reveal-fixture
                            Drive fixed revealed-tab interaction states.
  --tab-emit-source PATH   Install tab-emit from this source directory.
  --tab-emit-port PORT     Use an isolated tab-emit loopback port (default: 8765).
  --control-tab-source PATH
                            Install the generic control-tab demo and overflow fixtures.
  --tab-position POSITION  Use top, left, right, or bottom notebook tabs.
  --webdriver-library-path PATHS
                            Nix library path for downloaded browser drivers.
  --webdriver-loader PATH  Nix dynamic loader for downloaded browser drivers.
  --display :N              Nested X display (default: first free :100..:199).
  --geometry WIDTHxHEIGHT   Nested screen size (default: 1920x1080).
  --profile PATH            Isolated profile root (default: session profile).
  --plugins                 Load plugins; the default uses --safe-mode.

WINDOW for shot is "main", "picker", "root", or a numeric X window ID.
EOF
}

fail()
{
    printf 'error: %s\n' "$*" >&2
    exit 1
}

note()
{
    printf '%s\n' "$*"
}

smoke_once_cleanup()
{
    local status=$?
    trap - EXIT INT TERM HUP
    rm -f "${session_dir}/rumble-login-status.png"
    stop_session >/dev/null 2>&1 || true
    exit "$status"
}

session="${CHATTERINO_UI_SESSION:-default}"
while [[ $# -gt 0 ]]; do
    case "$1" in
        --session)
            [[ $# -ge 2 ]] || fail "--session requires a value"
            session="$2"
            shift 2
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            break
            ;;
    esac
done

[[ "$session" =~ ^[A-Za-z0-9_.-]+$ ]] ||
    fail "session names may contain only letters, numbers, dot, dash, and underscore"

command_name="${1:-help}"
if [[ $# -gt 0 ]]; then
    shift
fi

runtime_parent="${CHATTERINO_UI_STATE_DIR:-${XDG_RUNTIME_DIR:-/tmp}/chatterino-ui-xephyr-${UID}}"
session_dir="${runtime_parent}/${session}"
auth_file="${session_dir}/Xauthority"
display_file="${session_dir}/display"
main_window_file="${session_dir}/main-window"
profile_file="${session_dir}/profile-path"
tab_position_file="${session_dir}/tab-position"
scale_file="${session_dir}/scale"
artifacts_dir="${session_dir}/artifacts"
shared_font_cache="${runtime_parent}/fontconfig-cache"
shared_driver_cache="${runtime_parent}/browser-driver-cache"

require_command()
{
    command -v "$1" >/dev/null 2>&1 || fail "required program is missing: $1"
}

require_session()
{
    [[ -r "$display_file" ]] ||
        fail "session '${session}' is not started; run start first"
    [[ -r "$auth_file" ]] ||
        fail "session '${session}' has no X authority file"
}

read_display()
{
    require_session
    local value
    value="$(<"$display_file")"
    [[ "$value" =~ ^:[0-9]+$ ]] || fail "session display state is invalid"
    printf '%s' "$value"
}

inner()
{
    local nested_display
    nested_display="$(read_display)"
    env -u WAYLAND_DISPLAY -u WAYLAND_SOCKET \
        DISPLAY="$nested_display" \
        XAUTHORITY="$auth_file" \
        QT_QPA_PLATFORM=xcb \
        "$@"
}

display_ready()
{
    inner xdpyinfo >/dev/null 2>&1
}

read_pid()
{
    local role="$1"
    local path="${session_dir}/${role}.pid"
    [[ -r "$path" ]] || return 1
    local pid
    pid="$(<"$path")"
    [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
    printf '%s' "$pid"
}

process_alive()
{
    local role="$1"
    local pid
    pid="$(read_pid "$role")" || return 1
    kill -0 "$pid" 2>/dev/null
}

window_exists()
{
    local id="$1"
    inner xdotool getwindowgeometry "$id" >/dev/null 2>&1
}

first_window()
{
    local mode="$1"
    local pattern="$2"
    local ids
    ids="$(inner xdotool search --onlyvisible "$mode" "$pattern" 2>/dev/null || true)"
    [[ -n "$ids" ]] || return 1
    printf '%s\n' "${ids%%$'\n'*}"
}

wait_for_window()
{
    local mode="$1"
    local pattern="$2"
    local attempts="${3:-200}"
    local id
    for ((i = 0; i < attempts; i++)); do
        id="$(first_window "$mode" "$pattern" || true)"
        if [[ -n "$id" ]]; then
            printf '%s' "$id"
            return 0
        fi
        sleep 0.05
    done
    return 1
}

main_window()
{
    local id=""
    if [[ -r "$main_window_file" ]]; then
        id="$(<"$main_window_file")"
        if [[ "$id" =~ ^[0-9]+$ ]] && window_exists "$id"; then
            printf '%s' "$id"
            return 0
        fi
    fi

    id="$(first_window --class '[Cc]hatterino' || true)"
    if [[ -z "$id" ]]; then
        id="$(first_window --name 'Chatterino' || true)"
    fi
    [[ -n "$id" ]] || return 1
    printf '%s\n' "$id" >"$main_window_file"
    printf '%s' "$id"
}

wait_for_main_window()
{
    local id
    for ((i = 0; i < 3600; i++)); do
        id="$(main_window || true)"
        if [[ -n "$id" ]]; then
            printf '%s' "$id"
            return 0
        fi
        sleep 0.05
    done
    return 1
}

choose_display()
{
    local number
    for ((number = 100; number <= 199; number++)); do
        if [[ ! -e "/tmp/.X11-unix/X${number}" ]]; then
            printf ':%d' "$number"
            return 0
        fi
    done
    return 1
}

stop_role()
{
    local role="$1"
    local pid
    pid="$(read_pid "$role" || true)"
    [[ -n "$pid" ]] || return 0

    if kill -0 "$pid" 2>/dev/null; then
        kill -TERM -- "-${pid}" 2>/dev/null ||
            kill -TERM "$pid" 2>/dev/null ||
            true
    fi
}

wait_role_stopped()
{
    local role="$1"
    local pid
    pid="$(read_pid "$role" || true)"
    [[ -n "$pid" ]] || return 0

    for ((i = 0; i < 50; i++)); do
        if ! kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
        sleep 0.05
    done

    kill -KILL -- "-${pid}" 2>/dev/null ||
        kill -KILL "$pid" 2>/dev/null ||
        true
}

stop_session()
{
    if [[ ! -d "$session_dir" ]]; then
        note "session=${session} state=stopped"
        return 0
    fi

    stop_role chatterino
    stop_role openbox
    stop_role xephyr
    wait_role_stopped chatterino
    wait_role_stopped openbox
    wait_role_stopped xephyr
    rm -f \
        "${session_dir}/chatterino.pid" \
        "${session_dir}/openbox.pid" \
        "${session_dir}/xephyr.pid" \
        "$main_window_file" \
        "$display_file"
    note "session=${session} state=stopped profile-preserved=true"
}

doctor()
{
    local program
    for program in Xephyr xauth xdpyinfo openbox xdotool import magick \
        tesseract mcookie setsid; do
        require_command "$program"
    done

    [[ -n "${DISPLAY:-}" ]] ||
        fail "the outer host DISPLAY is unset; Xephyr needs the host Xwayland display"
    xdpyinfo >/dev/null 2>&1 ||
        fail "the outer host X display is not reachable"
    note "host-display=reachable required-programs=available"
}

start_session()
{
    local chatterino_path=""
    local nested_display=""
    local geometry="1920x1080"
    local profile=""
    local rumble_login_helper=""
    local selenium_manager="${CHATTERINO_SELENIUM_MANAGER:-}"
    local qt_plugin_path=""
    local qt_scale_factor=""
    local webdriver_library_path=""
    local webdriver_loader=""
    local tab_emit_source=""
    local tab_emit_port=8765
    local control_tab_source=""
    local tab_position="top"
    local load_plugins=false
    local rumble_usercard_fixture=false
    local rumble_reply_fixture=false
    local rumble_lifecycle_fixture=false
    local automatic_routing_fixture=false
    local compact_tab_reveal_fixture=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --chatterino)
                [[ $# -ge 2 ]] || fail "--chatterino requires a path"
                chatterino_path="$2"
                shift 2
                ;;
            --display)
                [[ $# -ge 2 ]] || fail "--display requires a value"
                nested_display="$2"
                shift 2
                ;;
            --rumble-login-helper)
                [[ $# -ge 2 ]] ||
                    fail "--rumble-login-helper requires a path"
                rumble_login_helper="$2"
                shift 2
                ;;
            --selenium-manager)
                [[ $# -ge 2 ]] ||
                    fail "--selenium-manager requires a path"
                selenium_manager="$2"
                shift 2
                ;;
            --qt-plugin-path)
                [[ $# -ge 2 ]] ||
                    fail "--qt-plugin-path requires a path"
                qt_plugin_path="$2"
                shift 2
                ;;
            --qt-scale-factor)
                [[ $# -ge 2 ]] ||
                    fail "--qt-scale-factor requires 1 or 2"
                qt_scale_factor="$2"
                shift 2
                ;;
            --rumble-usercard-fixture)
                rumble_usercard_fixture=true
                shift
                ;;
            --rumble-reply-fixture)
                rumble_reply_fixture=true
                shift
                ;;
            --rumble-lifecycle-fixture)
                rumble_lifecycle_fixture=true
                shift
                ;;
            --automatic-routing-fixture)
                automatic_routing_fixture=true
                shift
                ;;
            --compact-tab-reveal-fixture)
                compact_tab_reveal_fixture=true
                shift
                ;;
            --tab-emit-source)
                [[ $# -ge 2 ]] ||
                    fail "--tab-emit-source requires a path"
                tab_emit_source="$2"
                load_plugins=true
                shift 2
                ;;
            --tab-emit-port)
                [[ $# -ge 2 ]] ||
                    fail "--tab-emit-port requires a value"
                tab_emit_port="$2"
                shift 2
                ;;
            --control-tab-source)
                [[ $# -ge 2 ]] ||
                    fail "--control-tab-source requires a path"
                control_tab_source="$2"
                load_plugins=true
                shift 2
                ;;
            --tab-position)
                [[ $# -ge 2 ]] ||
                    fail "--tab-position requires top, left, right, or bottom"
                tab_position="$2"
                shift 2
                ;;
            --webdriver-library-path)
                [[ $# -ge 2 ]] ||
                    fail "--webdriver-library-path requires a value"
                webdriver_library_path="$2"
                shift 2
                ;;
            --webdriver-loader)
                [[ $# -ge 2 ]] ||
                    fail "--webdriver-loader requires a path"
                webdriver_loader="$2"
                shift 2
                ;;
            --geometry)
                [[ $# -ge 2 ]] || fail "--geometry requires a value"
                geometry="$2"
                shift 2
                ;;
            --profile)
                [[ $# -ge 2 ]] || fail "--profile requires a path"
                profile="$2"
                shift 2
                ;;
            --plugins)
                load_plugins=true
                shift
                ;;
            *)
                fail "unknown start option: $1"
                ;;
        esac
    done

    doctor
    [[ "$geometry" =~ ^[0-9]{3,5}x[0-9]{3,5}$ ]] ||
        fail "geometry must look like 1920x1080"
    if [[ -n "$qt_scale_factor" &&
          "$qt_scale_factor" != 1 && "$qt_scale_factor" != 2 ]]; then
        fail "--qt-scale-factor must be 1 or 2"
    fi
    if [[ ! "$tab_emit_port" =~ ^[0-9]+$ ]] ||
       ((tab_emit_port < 1 || tab_emit_port > 65535)); then
        fail "--tab-emit-port must be from 1 through 65535"
    fi
    if [[ -n "$tab_emit_source" ]]; then
        [[ -f "$tab_emit_source/init.lua" &&
           -f "$tab_emit_source/info.json" ]] ||
            fail "--tab-emit-source must contain init.lua and info.json"
        tab_emit_source="$(readlink -f "$tab_emit_source")"
    elif [[ "$tab_emit_port" != 8765 ]]; then
        fail "--tab-emit-port requires --tab-emit-source"
    fi
    if [[ -n "$control_tab_source" ]]; then
        [[ -f "$control_tab_source/init.lua" &&
           -f "$control_tab_source/info.json" ]] ||
            fail "--control-tab-source must contain init.lua and info.json"
        control_tab_source="$(readlink -f "$control_tab_source")"
    fi
    case "$tab_position" in
        top|left|right|bottom) ;;
        *) fail "--tab-position requires top, left, right, or bottom" ;;
    esac
    if [[ -n "$nested_display" ]]; then
        [[ "$nested_display" =~ ^:[0-9]+$ ]] ||
            fail "display must look like :100"
    else
        nested_display="$(choose_display)" ||
            fail "no free nested display was found from :100 through :199"
    fi

    if [[ -r "$display_file" ]] && display_ready; then
        fail "session '${session}' is already running on $(<"$display_file")"
    fi

    if [[ -z "$chatterino_path" ]]; then
        chatterino_path="${CHATTERINO_UI_DEFAULT_APP:-}"
    fi
    if [[ -z "$chatterino_path" ]]; then
        chatterino_path="$(command -v chatterino || true)"
    fi
    [[ -n "$chatterino_path" && -x "$chatterino_path" ]] ||
        fail "Chatterino is not executable; pass --chatterino PATH"
    chatterino_path="$(readlink -f "$chatterino_path")"
    local -a chatterino_env=(
        "CHATTERINO_RUMBLE_LOGIN_TEST_X11=1"
    )
    if [[ -n "$qt_scale_factor" ]]; then
        chatterino_env+=("QT_SCALE_FACTOR=${qt_scale_factor}")
    fi
    if [[ "$rumble_usercard_fixture" == true ]]; then
        chatterino_env+=(
            "CHATTERINO_UI_TEST_RUMBLE_USERCARD_FIXTURE=1"
        )
    fi
    if [[ "$rumble_reply_fixture" == true ]]; then
        chatterino_env+=(
            "CHATTERINO_UI_TEST_RUMBLE_REPLY_FIXTURE=1"
        )
    fi
    if [[ "$rumble_lifecycle_fixture" == true ]]; then
        chatterino_env+=(
            "CHATTERINO_UI_TEST_RUMBLE_LIFECYCLE_FIXTURE=1"
        )
    fi
    if [[ "$automatic_routing_fixture" == true ]]; then
        chatterino_env+=(
            "CHATTERINO_UI_TEST_AUTOMATIC_ROUTING_FIXTURE=1"
        )
    fi
    if [[ "$compact_tab_reveal_fixture" == true ]]; then
        chatterino_env+=(
            "CHATTERINO_UI_TEST_COMPACT_TAB_REVEAL_FIXTURE=1"
        )
    fi
    if [[ -n "$rumble_login_helper" ]]; then
        [[ -x "$rumble_login_helper" ]] ||
            fail "Rumble login test override is not executable: ${rumble_login_helper}"
        rumble_login_helper="$(readlink -f "$rumble_login_helper")"
        chatterino_env+=(
            "CHATTERINO_RUMBLE_LOGIN_HELPER=${rumble_login_helper}"
        )
    fi
    if [[ -n "$selenium_manager" ]]; then
        [[ -x "$selenium_manager" ]] ||
            fail "Selenium Manager is not executable: ${selenium_manager}"
        selenium_manager="$(readlink -f "$selenium_manager")"
        chatterino_env+=(
            "CHATTERINO_SELENIUM_MANAGER=${selenium_manager}"
        )
    fi
    if [[ -n "$qt_plugin_path" ]]; then
        [[ -d "$qt_plugin_path" ]] ||
            fail "Qt plugin path is not a directory: ${qt_plugin_path}"
        qt_plugin_path="$(readlink -f "$qt_plugin_path")"
        chatterino_env+=(
            "QT_PLUGIN_PATH=${qt_plugin_path}"
        )
    fi
    if [[ -n "$webdriver_library_path" ]]; then
        chatterino_env+=(
            "CHATTERINO_WEBDRIVER_LIBRARY_PATH=${webdriver_library_path}"
        )
    fi
    if [[ -n "$webdriver_loader" ]]; then
        [[ -x "$webdriver_loader" ]] ||
            fail "WebDriver loader is not executable: ${webdriver_loader}"
        webdriver_loader="$(readlink -f "$webdriver_loader")"
        chatterino_env+=(
            "CHATTERINO_WEBDRIVER_LOADER=${webdriver_loader}"
        )
    fi

    umask 077
    mkdir -p "$session_dir" "$artifacts_dir" "$shared_font_cache" \
        "$shared_driver_cache"
    chmod 700 "$runtime_parent" "$session_dir"
    if [[ -z "$profile" ]]; then
        profile="${session_dir}/profile"
    fi
    mkdir -p \
        "$profile/home" \
        "$profile/config" \
        "$profile/data" \
        "$profile/cache" \
        "$profile/cache/chatterino" \
        "$profile/state"
    if [[ ! -e "$profile/cache/fontconfig" &&
          ! -L "$profile/cache/fontconfig" ]]; then
        ln -s "$shared_font_cache" "$profile/cache/fontconfig"
    fi
    if [[ ! -e "$profile/cache/chatterino/browser-drivers" &&
          ! -L "$profile/cache/chatterino/browser-drivers" ]]; then
        ln -s "$shared_driver_cache" \
            "$profile/cache/chatterino/browser-drivers"
    fi
    profile="$(readlink -f "$profile")"
    local settings_path="${profile}/data/chatterino/Settings/settings.json"
    local settings_tmp="${settings_path}.ui-harness.tmp"

    if [[ -n "$tab_emit_source" ]]; then
        local tab_emit_target="${profile}/data/chatterino/Plugins/tab-emit"
        install -Dm644 "$tab_emit_source/init.lua" \
            "$tab_emit_target/init.lua"
        install -Dm644 "$tab_emit_source/info.json" \
            "$tab_emit_target/info.json"
        sed -i \
            "s|^local WS_URL = .*$|local WS_URL = \"ws://127.0.0.1:${tab_emit_port}\"|" \
            "$tab_emit_target/init.lua"
        grep -Fx \
            "local WS_URL = \"ws://127.0.0.1:${tab_emit_port}\"" \
            "$tab_emit_target/init.lua" >/dev/null ||
            fail "could not configure the isolated tab-emit endpoint"
        mkdir -p "$(dirname "$settings_path")"
        if [[ -f "$settings_path" ]]; then
            jq '
                .plugins.supportEnabled = true
                | .plugins.enabledPlugins = ["tab-emit"]
            ' "$settings_path" >"$settings_tmp"
        else
            jq -n '{
                plugins: {
                    supportEnabled: true,
                    enabledPlugins: ["tab-emit"]
                }
            }' >"$settings_tmp"
        fi
        mv "$settings_tmp" "$settings_path"
    fi

    if [[ -n "$control_tab_source" ]]; then
        local control_tab_target id index
        local control_tab_ids='[
            "control-tab-demo",
            "control-tab-fixture-01", "control-tab-fixture-02",
            "control-tab-fixture-03", "control-tab-fixture-04",
            "control-tab-fixture-05", "control-tab-fixture-06",
            "control-tab-fixture-07", "control-tab-fixture-08",
            "control-tab-fixture-09", "control-tab-fixture-10",
            "control-tab-fixture-11"
        ]'
        control_tab_target="${profile}/data/chatterino/Plugins/control-tab-demo"
        install -Dm644 "$control_tab_source/init.lua" \
            "$control_tab_target/init.lua"
        install -Dm644 "$control_tab_source/info.json" \
            "$control_tab_target/info.json"
        for index in {01..11}; do
            id="control-tab-fixture-${index}"
            control_tab_target="${profile}/data/chatterino/Plugins/${id}"
            install -Dm644 "$control_tab_source/init.lua" \
                "$control_tab_target/init.lua"
            mkdir -p "$control_tab_target"
            jq --arg name "Control Fixture ${index}" \
                '.name = $name' "$control_tab_source/info.json" \
                >"$control_tab_target/info.json"
        done
        mkdir -p "$(dirname "$settings_path")"
        if [[ -f "$settings_path" ]]; then
            jq --argjson ids "$control_tab_ids" '
                .plugins.supportEnabled = true
                | .plugins.enabledPlugins =
                    (((.plugins.enabledPlugins // []) + $ids) | unique)
            ' "$settings_path" >"$settings_tmp"
        else
            jq -n --argjson ids "$control_tab_ids" '{
                plugins: {
                    supportEnabled: true,
                    enabledPlugins: $ids
                }
            }' >"$settings_tmp"
        fi
        mv "$settings_tmp" "$settings_path"
    fi

    local tab_position_value=0
    case "$tab_position" in
        left) tab_position_value=1 ;;
        right) tab_position_value=2 ;;
        bottom) tab_position_value=3 ;;
    esac
    mkdir -p "$(dirname "$settings_path")"
    if [[ -f "$settings_path" ]]; then
        jq --argjson position "$tab_position_value" \
            '.appearance.tabDirection = $position' \
            "$settings_path" >"$settings_tmp"
    else
        jq -n --argjson position "$tab_position_value" \
            '{appearance: {tabDirection: $position}}' >"$settings_tmp"
    fi
    mv "$settings_tmp" "$settings_path"

    : >"$auth_file"
    chmod 600 "$auth_file"
    local cookie
    cookie="$(mcookie)"
    xauth -f "$auth_file" add "$nested_display" MIT-MAGIC-COOKIE-1 "$cookie"
    unset cookie

    printf '%s\n' "$nested_display" >"$display_file"
    printf '%s\n' "$profile" >"$profile_file"
    printf '%s\n' "$tab_position" >"$tab_position_file"
    printf '%s\n' "${qt_scale_factor:-1}" >"$scale_file"

    setsid Xephyr "$nested_display" \
        -screen "$geometry" \
        -auth "$auth_file" \
        -nolisten tcp \
        -noreset \
        -br \
        -name "Chatterino UI Test (${session})" \
        >>"${session_dir}/xephyr.log" 2>&1 </dev/null &
    printf '%s\n' "$!" >"${session_dir}/xephyr.pid"

    local ready=false
    for ((i = 0; i < 200; i++)); do
        if display_ready; then
            ready=true
            break
        fi
        if ! process_alive xephyr; then
            break
        fi
        sleep 0.05
    done
    if [[ "$ready" != true ]]; then
        stop_session >/dev/null
        fail "Xephyr did not start; inspect ${session_dir}/xephyr.log"
    fi

    setsid env -u WAYLAND_DISPLAY -u WAYLAND_SOCKET \
        DISPLAY="$nested_display" \
        XAUTHORITY="$auth_file" \
        HOME="$profile/home" \
        XDG_CONFIG_HOME="$profile/config" \
        XDG_DATA_HOME="$profile/data" \
        XDG_CACHE_HOME="$profile/cache" \
        XDG_STATE_HOME="$profile/state" \
        openbox --sm-disable \
        >>"${session_dir}/openbox.log" 2>&1 </dev/null &
    printf '%s\n' "$!" >"${session_dir}/openbox.pid"

    # Let the window manager claim the root window before the first Qt window
    # is mapped. Starting both clients in the same scheduler tick can otherwise
    # leave a fresh profile running without a managed main window.
    sleep 0.25
    if ! process_alive openbox; then
        stop_session >/dev/null
        fail "Openbox stopped during startup; inspect ${session_dir}/openbox.log"
    fi

    local -a chatterino_args=(--verbose)
    if [[ "$load_plugins" != true ]]; then
        chatterino_args+=(--safe-mode)
    fi

    setsid env -u WAYLAND_DISPLAY -u WAYLAND_SOCKET \
        DISPLAY="$nested_display" \
        XAUTHORITY="$auth_file" \
        QT_QPA_PLATFORM=xcb \
        HOME="$profile/home" \
        XDG_CONFIG_HOME="$profile/config" \
        XDG_DATA_HOME="$profile/data" \
        XDG_CACHE_HOME="$profile/cache" \
        XDG_STATE_HOME="$profile/state" \
        "${chatterino_env[@]}" \
        "$chatterino_path" "${chatterino_args[@]}" \
        >>"${session_dir}/chatterino.log" 2>&1 </dev/null &
    printf '%s\n' "$!" >"${session_dir}/chatterino.pid"

    local main
    main="$(wait_for_main_window || true)"
    if [[ -z "$main" ]]; then
        stop_session >/dev/null
        fail "Chatterino did not create a window; inspect ${session_dir}/chatterino.log"
    fi
    printf '%s\n' "$main" >"$main_window_file"
    inner xdotool windowactivate --sync "$main" 2>/dev/null
    local screen_width screen_height window_width window_height
    read -r screen_width screen_height < <(inner xdotool getdisplaygeometry)
    [[ "$screen_width" =~ ^[0-9]+$ && "$screen_height" =~ ^[0-9]+$ ]] ||
        fail "could not read the nested screen geometry"
    window_width=$((screen_width - 4))
    window_height=$((screen_height - 24))
    inner xdotool windowsize --sync "$main" "$window_width" "$window_height"
    inner xdotool windowmove --sync "$main" 2 18
    sleep 0.15

    note "session=${session} state=running display=${nested_display} main-window=${main}"
    note "profile=${profile}"
    note "artifacts=${artifacts_dir}"
}

session_status()
{
    if [[ ! -r "$display_file" ]]; then
        note "session=${session} state=stopped"
        return 1
    fi

    local nested_display
    nested_display="$(<"$display_file")"
    local display_state=unreachable
    if display_ready; then
        display_state=reachable
    fi

    local main=none
    main="$(main_window || true)"
    [[ -n "$main" ]] || main=none
    note "session=${session} display=${nested_display} display-state=${display_state} main-window=${main}"
    local role state
    for role in xephyr openbox chatterino; do
        state=stopped
        if process_alive "$role"; then
            state=running
        fi
        note "${role}=${state}"
    done
    [[ "$display_state" == reachable && "$main" != none ]]
}

