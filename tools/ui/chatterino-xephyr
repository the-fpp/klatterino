control_tab_smoke()
{
    local main popup="" ids candidate
    main="$(main_window || true)"
    [[ -n "$main" ]] || fail "the Chatterino main window was not found"
    sleep 0.5

    # Plugin discovery is asynchronous. Wait for the expected overflow affordance
    # instead of racing a partially loaded row. Its native dark button needs a
    # tight high-contrast crop for reliable OCR.
    local tested_scale=1 overflow_ready=false crop_width crop_height crop_x
    local overflow_image="${session_dir}/control-tab-overflow.png"
    [[ -r "$scale_file" ]] && tested_scale="$(<"$scale_file")"
    read_window_size "$main" || fail "could not read the Chatterino window size"
    crop_width=$((190 * tested_scale))
    crop_height=$((64 * tested_scale))
    crop_x=$((WINDOW_WIDTH - crop_width))
    for ((i = 0; i < 80; i++)); do
        shot_window control-tab-initial "$main"
        magick "$LAST_FULL" \
            -crop "${crop_width}x${crop_height}+${crop_x}+0" \
            -resize 400% -colorspace Gray -threshold 50% -negate \
            "$overflow_image"
        OCR_TEXT="$(tesseract "$overflow_image" stdout --psm 7 \
            2>/dev/null || true)"
        if [[ "${OCR_TEXT,,}" == *"more"* ]]; then
            overflow_ready=true
            break
        fi
        sleep 0.05
    done
    rm -f "$overflow_image"
    [[ "$overflow_ready" == true ]] ||
        fail "the plugin control-tab overflow was not rendered"
    OCR_TEXT="$(tesseract "$LAST_FULL" stdout --psm 11 2>/dev/null || true)"
    OCR_LOWER="${OCR_TEXT,,}"
    [[ "$OCR_LOWER" == *"harness"* &&
       "$OCR_LOWER" == *"2 checks"* ]] ||
        fail "the plugin control-tab row or overflow control was not rendered"

    shot_window control-tab-open-target "$main"
    click_first_control_tab "$main"
    sleep 0.5
    ocr_snapshot "$main" control-tab-panel
    [[ "$OCR_LOWER" == *"controls from control tab demo"* &&
       "$OCR_LOWER" == *"all systems nominal"* &&
       "$OCR_LOWER" == *"health"* &&
       "$OCR_LOWER" == *"notifications"* &&
       "$OCR_LOWER" == *"rumble-usercard-fixture"* ]] ||
        fail "the host-rendered control panel was incomplete"

    # Opening a panel focuses its first enabled native control. Activate the
    # action with Space; this avoids coordinate/OCR assumptions about the
    # low-contrast native button and proves keyboard operation.
    shot_window control-tab-pulse-target "$main"
    inner xdotool key --window "$main" --clearmodifiers space
    read_window_size "$main" || fail "could not read the Chatterino window size"
    local input_x=$((WINDOW_WIDTH / 2))
    local input_y=$((WINDOW_HEIGHT - 35))
    inner xdotool mousemove --sync --window "$main" "$input_x" "$input_y"
    inner xdotool click --window "$main" 1
    sleep 0.15
    inner xdotool type --window "$main" --clearmodifiers --delay 15 focusstable
    sleep 1.1
    ocr_snapshot "$main" control-tab-focus
    [[ "$OCR_LOWER" == *"focusstable"* ]] ||
        fail "plugin state updates stole focus from the message input"
    inner xdotool key --window "$main" --clearmodifiers ctrl+a BackSpace

    click_first_control_tab "$main"
    sleep 0.15
    ocr_snapshot "$main" control-tab-pulse-result
    [[ "$OCR_LOWER" == *"pulse complete"* ]] ||
        fail "the host action did not publish its authoritative result"
    inner xdotool key --window "$main" --clearmodifiers Tab space
    sleep 0.2
    ocr_snapshot "$main" control-tab-toggle-result
    [[ "$OCR_LOWER" == *"toggle confirmed"* ]] ||
        fail "the authoritative toggle result was not rendered"

    shot_window control-tab-choice-target "$main"
    inner xdotool key --window "$main" --clearmodifiers Tab End
    sleep 0.2
    ocr_snapshot "$main" control-tab-choice-result
    [[ "$OCR_LOWER" == *"choice confirmed"* ]] ||
        fail "the authoritative choice result was not rendered"

    inner xdotool key --window "$main" --clearmodifiers Escape
    sleep 0.15
    ocr_snapshot "$main" control-tab-escape
    [[ "$OCR_LOWER" != *"controls from"* ]] ||
        fail "Escape did not close the control panel"

    click_first_control_tab "$main"
    sleep 0.15
    read_window_size "$main" || fail "could not read the Chatterino window size"
    inner xdotool mousemove --sync --window "$main" \
        $((WINDOW_WIDTH / 2)) $((WINDOW_HEIGHT / 2))
    inner xdotool click --window "$main" 1
    sleep 0.15
    ocr_snapshot "$main" control-tab-outside
    [[ "$OCR_LOWER" != *"controls from"* ]] ||
        fail "an outside click did not close the control panel"

    inner xdotool windowactivate --sync "$main" 2>/dev/null
    inner xdotool key --window "$main" --clearmodifiers ctrl+n
    for ((i = 0; i < 200; i++)); do
        ids="$(inner xdotool search --onlyvisible --class '[Cc]hatterino' \
            2>/dev/null || true)"
        while IFS= read -r candidate; do
            if [[ "$candidate" =~ ^[0-9]+$ && "$candidate" != "$main" ]]; then
                popup="$candidate"
                break
            fi
        done <<<"$ids"
        [[ -z "$popup" ]] || break
        sleep 0.05
    done
    [[ -n "$popup" ]] || fail "Ctrl+N did not create a Chatterino popup window"
    sleep 0.25
    ocr_snapshot "$popup" control-tab-popup
    [[ "$OCR_LOWER" == *"harness"* &&
       "$OCR_LOWER" == *"2 checks"* ]] ||
        fail "the plugin control tabs were not rendered in the popup window"
    # The popup may be positioned or scaled differently from the main window;
    # target the unique owner label rather than assuming a fixed x coordinate.
    click_ocr_word "$popup" "harness" "control-tab-popup-click"
    # A popup completes its client-layout pass asynchronously. Poll a bounded
    # interval rather than sampling a transient empty backing store.
    local popup_panel_ready=false
    for ((i = 0; i < 20; i++)); do
        ocr_snapshot "$popup" control-tab-popup-panel
        if [[ "$OCR_LOWER" == *"controls from control tab demo"* ]]; then
            popup_panel_ready=true
            break
        fi
        sleep 0.1
    done
    [[ "$popup_panel_ready" == true ]] ||
        fail "the plugin control panel did not open in the popup window"
    # The popup-panel assertion above proves this supported window type. Let
    # the session cleanup own its destruction: some X11 window managers remove
    # the window before xdotool completes a synthetic close request, which is
    # a teardown race rather than an interaction result.

    # X11 can report a queued BadWindow from the popup's self-destruction on
    # this next request. The main-window activation itself is best-effort; the
    # following screenshot still authoritatively verifies the compact state.
    inner xdotool windowactivate --sync "$main" >/dev/null 2>&1 || true
    inner xdotool windowsize --sync "$main" 900 500
    inner xdotool windowmove --sync "$main" 20 20
    sleep 0.4
    ocr_snapshot "$main" control-tab-compact-narrow
    [[ "$OCR_LOWER" == *"harness"* ]] ||
        fail "the control-tab compact overflow fallback was not usable"

    local position=unknown
    [[ -r "$tab_position_file" ]] && position="$(<"$tab_position_file")"
    [[ -r "$scale_file" ]] && tested_scale="$(<"$scale_file")"
    note "control-tabs=passed main=yes popup=yes controls=all focus=stable dismissal=escape-and-outside overflow=bounded compact=yes position=${position} scale=${tested_scale} rtl=unit-covered"
    note "preview=${LAST_PREVIEW}"
}

control_tab_smoke_once()
{
    local has_source=false argument
    for argument in "$@"; do
        if [[ "$argument" == --control-tab-source ]]; then
            has_source=true
            break
        fi
    done
    [[ "$has_source" == true ]] ||
        fail "control-tab-smoke-once requires --control-tab-source PATH"
    trap smoke_once_cleanup EXIT
    trap 'exit 130' INT TERM HUP
    # The isolated user-card fixture creates a normal Split and SplitInput
    # without contacting a live service. That lets the control-tab pulse prove
    # that state-only rerenders preserve actual message-input focus.
    start_session --rumble-usercard-fixture "$@"
    control_tab_smoke
    stop_session
    trap - EXIT INT TERM HUP
}

rumble_login_smoke()
{
    rumble_login_open

    local display_geometry screen_width screen_height
    display_geometry="$(inner xdpyinfo | sed -n \
        's/.*dimensions: *\([0-9][0-9]*\)x\([0-9][0-9]*\).*/\1 \2/p' |
        head -n 1)"
    read -r screen_width screen_height <<<"$display_geometry"
    [[ "$screen_width" =~ ^[1-9][0-9]*$ &&
       "$screen_height" =~ ^[1-9][0-9]*$ ]] ||
        fail "could not determine the nested display geometry"

    local geometry x y width height
    geometry="$(inner xdotool getwindowgeometry --shell \
        "$RUMBLE_LOGIN_BROWSER")"
    x="$(sed -n 's/^X=//p' <<<"$geometry")"
    y="$(sed -n 's/^Y=//p' <<<"$geometry")"
    width="$(sed -n 's/^WIDTH=//p' <<<"$geometry")"
    height="$(sed -n 's/^HEIGHT=//p' <<<"$geometry")"
    [[ "$x" =~ ^-?[0-9]+$ && "$y" =~ ^-?[0-9]+$ &&
       "$width" =~ ^[1-9][0-9]*$ && "$height" =~ ^[1-9][0-9]*$ ]] ||
        fail "could not determine the Rumble login window geometry"
    ((x >= 0 && y >= 0 &&
      x + width <= screen_width && y + height <= screen_height)) ||
        fail "the Rumble login window does not fit the nested display"
    ((width < screen_width || height < screen_height)) ||
        fail "the Rumble login window unexpectedly filled the display"

    local resized_width resized_height moved_x moved_y resized_geometry
    local actual_x actual_y actual_width actual_height
    resized_width=$((x + width + 50 <= screen_width ? width + 50 : width - 50))
    resized_height=$((y + height + 50 <= screen_height ? height + 50 : height - 50))
    moved_x=$((x + 20))
    moved_y=$((y + 20))
    inner xdotool windowsize --sync "$RUMBLE_LOGIN_BROWSER" \
        "$resized_width" "$resized_height"
    inner xdotool windowmove --sync "$RUMBLE_LOGIN_BROWSER" \
        "$moved_x" "$moved_y"
    resized_geometry="$(inner xdotool getwindowgeometry --shell \
        "$RUMBLE_LOGIN_BROWSER")"
    actual_x="$(sed -n 's/^X=//p' <<<"$resized_geometry")"
    actual_y="$(sed -n 's/^Y=//p' <<<"$resized_geometry")"
    actual_width="$(sed -n 's/^WIDTH=//p' <<<"$resized_geometry")"
    actual_height="$(sed -n 's/^HEIGHT=//p' <<<"$resized_geometry")"
    note "rumble-login-resize=requested-${resized_width}x${resized_height}+${moved_x}+${moved_y} actual-${actual_width}x${actual_height}+${actual_x}+${actual_y}"
    [[ "$actual_width" == "$resized_width" &&
       "$actual_height" == "$resized_height" ]] ||
        fail "the Rumble login window could not be resized"
    [[ "$actual_x" == "$moved_x" && "$actual_y" == "$moved_y" ]] ||
        fail "the Rumble login window could not be moved"
    note "rumble-login-window=fitted movable=true resizable=true initial-geometry=${width}x${height}+${x}+${y}"

    sleep 2
    shot_window rumble-login-browser root
    note "preview=${LAST_PREVIEW}"

    # The same button becomes Cancel while the driver is active. Activating the
    # Add Account dialog first restores keyboard focus to that button without
    # relying on scale-sensitive coordinates.
    inner xdotool windowactivate --sync "$RUMBLE_LOGIN_DIALOG" 2>/dev/null
    inner xdotool key --window "$RUMBLE_LOGIN_DIALOG" --clearmodifiers Return

    local browser_closed=false
    for ((i = 0; i < 600; i++)); do
        if ! window_exists "$RUMBLE_LOGIN_BROWSER"; then
            browser_closed=true
            break
        fi
        sleep 0.05
    done
    if [[ "$browser_closed" != true ]]; then
        shot_window rumble-login-cancel-failure root
        note "rumble-login-browser=still-open"
        note "preview=${LAST_PREVIEW}"
        return 1
    fi

    # Wait for the driver's finished callback, not only the browser window.
    # OCR stays local and only the fixed cancellation marker is reported.
    local callback_finished=false ocr lower
    for ((i = 0; i < 100; i++)); do
        shot_window rumble-login-cancelled "$RUMBLE_LOGIN_DIALOG"
        magick "$LAST_FULL" -colorspace Gray -negate -threshold 35% \
            "${session_dir}/rumble-login-status.png"
        ocr="$(tesseract "${session_dir}/rumble-login-status.png" stdout \
            --psm 6 2>/dev/null || true)"
        lower="${ocr,,}"
        if [[ "$lower" == *"login was cancelled"* ]]; then
            callback_finished=true
            break
        fi
        sleep 0.05
    done
    if [[ "$callback_finished" != true ]]; then
        note "rumble-login-browser=closed driver=unconfirmed"
        note "preview=${LAST_PREVIEW}"
        return 1
    fi

    note "rumble-login-browser=closed driver=stopped"
    note "preview=${LAST_PREVIEW}"
}

accounts_open()
{
    local main settings
    main="$(main_window || true)"
    [[ -n "$main" ]] || fail "the Chatterino main window was not found"

    # A main window can become visible while first-run initialization is still
    # completing. Retry the harmless shortcut instead of spending a model turn
    # deciding whether a single early key event was lost.
    settings=""
    for ((i = 0; i < 1200; i++)); do
        settings="$(first_window --name '^Chatterino Settings$' || true)"
        [[ -n "$settings" ]] && break
        if ((i % 20 == 0)); then
            inner xdotool windowactivate --sync "$main" 2>/dev/null
            inner xdotool key --window "$main" --clearmodifiers ctrl+p
        fi
        sleep 0.05
    done
    if [[ -z "$settings" ]]; then
        shot_window rumble-login-settings-failure root
        note "rumble-login-settings=not-opened"
        note "preview=${LAST_PREVIEW}"
        return 1
    fi

    # Accounts is the fourth visible settings category at the harness's fixed
    # geometry and scale.
    inner xdotool mousemove --sync --window "$settings" 130 250
    inner xdotool click --window "$settings" 1
    sleep 0.2
    note "accounts-settings-window=${settings}"
}

account_add_open()
{
    local settings dialog
    accounts_open
    settings="$(first_window --name '^Chatterino Settings$' || true)"
    [[ -n "$settings" ]] || fail "the Accounts settings window was not found"
    inner xdotool mousemove --sync --window "$settings" 366 120
    inner xdotool click --window "$settings" 1
    dialog="$(wait_for_window --name '^Add new account$' 100 || true)"
    [[ -n "$dialog" ]] || fail "the Add new account dialog did not open"
    note "add-account-window=${dialog}"
}

rumble_account_tab_open()
{
    local dialog
    account_add_open
    dialog="$(first_window --name '^Add new account$' || true)"
    [[ -n "$dialog" ]] || fail "the Add new account dialog was not found"
    inner xdotool mousemove --sync --window "$dialog" 340 50
    inner xdotool click --window "$dialog" 1
    sleep 0.5
    note "rumble-account-window=${dialog}"
}

rumble_login_open()
{
    local settings browser
    local dialog ocr lower ready=false
    rumble_account_tab_open
    settings="$(first_window --name '^Chatterino Settings$' || true)"
    dialog="$(first_window --name '^Add new account$' || true)"
    [[ -n "$settings" && -n "$dialog" ]] ||
        fail "the Rumble account dialog was not found"

    for ((i = 0; i < 300; i++)); do
        shot_window rumble-login-preparation "$dialog"
        magick "$LAST_FULL" -colorspace Gray -negate -threshold 35% \
            "${session_dir}/rumble-login-status.png"
        ocr="$(tesseract "${session_dir}/rumble-login-status.png" stdout \
            --psm 6 2>/dev/null || true)"
        lower="${ocr,,}"
        if [[ "$lower" == *"ready for secure rumble sign-in"* ]]; then
            ready=true
            break
        fi
        if [[ "$lower" == *"could not prepare"* ||
              "$lower" == *"credential storage is unavailable"* ]]; then
            break
        fi
        sleep 0.2
    done
    if [[ "$ready" != true ]]; then
        note "rumble-login-preparation=not-ready"
        note "preview=${LAST_PREVIEW}"
        return 1
    fi

    inner xdotool windowactivate --sync "$dialog" 2>/dev/null
    inner xdotool mousemove --sync --window "$dialog" 419 315
    inner xdotool click --window "$dialog" 1

    browser="$(wait_for_window --class \
        '(Google-chrome-for-testing|Chromium|Google-chrome|Microsoft-edge|Brave-browser|firefox)' 1200 || true)"
    if [[ -z "$browser" ]]; then
        browser="$(wait_for_window --name \
            '(Google Chrome for Testing|Chromium|Google Chrome|Microsoft Edge|Brave|Firefox)' 20 || true)"
    fi
    if [[ -z "$browser" ]]; then
        shot_window rumble-login-launch-failure "$settings"
        note "rumble-login-browser=not-opened"
        note "preview=${LAST_PREVIEW}"
        return 1
    fi

    # A Chromium process exposes its blank app window before ChromeDriver has
    # attached, applied mobile emulation, and initiated navigation. Waiting for
    # a non-placeholder title makes screenshots and attended input begin on the
    # actual public login form instead of racing the initial New Tab window.
    local title title_lower page_ready=false
    for ((i = 0; i < 600; i++)); do
        if ! window_exists "$browser"; then
            break
        fi
        title="$(inner xdotool getwindowname "$browser" 2>/dev/null || true)"
        title_lower="${title,,}"
        if [[ -n "$title_lower" &&
              "$title_lower" != *"new tab"* &&
              "$title_lower" != *"about:blank"* &&
              "$title_lower" != "rumble.com_/account/login" &&
              "$title_lower" != "chromium" &&
              "$title_lower" != "google chrome" &&
              "$title_lower" != "microsoft edge" &&
              "$title_lower" != "brave" &&
              "$title_lower" != "firefox" ]]; then
            page_ready=true
            break
        fi
        sleep 0.05
    done
    if [[ "$page_ready" != true ]]; then
        shot_window rumble-login-navigation-failure "$settings"
        note "rumble-login-browser=page-not-ready"
        note "preview=${LAST_PREVIEW}"
        return 1
    fi

    RUMBLE_LOGIN_SETTINGS="$settings"
    RUMBLE_LOGIN_DIALOG="$dialog"
    RUMBLE_LOGIN_BROWSER="$browser"
    note "rumble-login-browser=opened"
}

rumble_login_live()
{
    rumble_login_open
    note "awaiting-user-login=true timeout-seconds=600"

    local browser_closed=false
    for ((i = 0; i < 12000; i++)); do
        if ! window_exists "$RUMBLE_LOGIN_BROWSER"; then
            browser_closed=true
            break
        fi
        sleep 0.05
    done
    if [[ "$browser_closed" != true ]]; then
        note "rumble-login=timeout"
        return 1
    fi

    local ocr_path="${session_dir}/rumble-login-status.png"
    local outcome=unconfirmed ocr lower
    for ((i = 0; i < 240; i++)); do
        if ! window_exists "$RUMBLE_LOGIN_DIALOG"; then
            inner xdotool windowactivate --sync \
                "$RUMBLE_LOGIN_SETTINGS" 2>/dev/null
            inner import -silent -window \
                "$RUMBLE_LOGIN_SETTINGS" "$ocr_path"
            ocr="$(tesseract "$ocr_path" stdout --psm 6 \
                2>/dev/null || true)"
            lower="${ocr,,}"
            if [[ "$lower" == *"rumble"* ]]; then
                outcome=account-added
                break
            fi
        else
            inner import -silent -window \
                "$RUMBLE_LOGIN_DIALOG" "$ocr_path"
            magick "$ocr_path" -colorspace Gray -negate -threshold 35% \
                "${ocr_path}.prepared"
            ocr="$(tesseract "${ocr_path}.prepared" stdout --psm 6 \
                2>/dev/null || true)"
            lower="${ocr,,}"
            if [[ "$lower" == *"secure credential storage is unavailable"* ]]
            then
                outcome="storage-unavailable"
                break
            fi
            if [[ "$lower" == *"access to secure credential storage was denied"* ]]
            then
                outcome="storage-denied"
                break
            fi
            if [[ "$lower" == *"could not update secure credential storage"* ]]
            then
                outcome="storage-failed"
                break
            fi
            if [[ "$lower" == *"could not validate the session"* ]]; then
                outcome="validation-failed"
                break
            fi
            if [[ "$lower" == *"rejected and cleared the session"* ||
                  "$lower" == *"browser session was rejected locally"* ]]
            then
                outcome="session-rejected"
                break
            fi
            if [[ "$lower" == *"did not return an account name"* ||
                  "$lower" == *"did not return a valid account name"* ]]
            then
                outcome="account-name-missing"
                break
            fi
            if [[ "$lower" == *"login was cancelled"* ]]; then
                outcome=cancelled
                break
            fi
            if [[ "$lower" == *"timed out"* ]]; then
                outcome=timeout
                break
            fi
            if [[ "$lower" == *"could not"* ||
                  "$lower" == *"rejected"* ]]; then
                outcome=failed
                break
            fi
        fi
        sleep 0.25
    done
    rm -f "$ocr_path" "${ocr_path}.prepared"
    note "rumble-login=${outcome} browser=closed driver=stopped"
    [[ "$outcome" == account-added ]]
}

rumble_login_smoke_once()
{
    trap smoke_once_cleanup EXIT
    trap 'exit 130' INT TERM HUP
    start_session "$@"
    rumble_login_smoke
    stop_session
    trap - EXIT INT TERM HUP
}

rumble_login_live_once()
{
    trap smoke_once_cleanup EXIT
    trap 'exit 130' INT TERM HUP
    start_session "$@"
    rumble_login_live
    stop_session
    trap - EXIT INT TERM HUP
}

case "$command_name" in
    help)
        usage
        ;;
    doctor)
        doctor "$@"
        ;;
    start)
        start_session "$@"
        ;;
    status)
        [[ $# -eq 0 ]] || fail "status takes no arguments"
        session_status
        ;;
    env)
        [[ $# -eq 0 ]] || fail "env takes no arguments"
        print_env
        ;;
    windows)
        [[ $# -eq 0 ]] || fail "windows takes no arguments"
        list_windows
        ;;
    accounts-open)
        [[ $# -eq 0 ]] || fail "accounts-open takes no arguments"
        accounts_open
        ;;
    account-add-open)
        [[ $# -eq 0 ]] || fail "account-add-open takes no arguments"
        account_add_open
        ;;
    rumble-account-tab-open)
        [[ $# -eq 0 ]] || fail "rumble-account-tab-open takes no arguments"
        rumble_account_tab_open
        ;;
    rumble-open)
        rumble_open "$@"
        ;;
    rumble-status)
        [[ $# -eq 0 ]] || fail "rumble-status takes no arguments"
        rumble_status
        ;;
    rumble-login-open)
        [[ $# -eq 0 ]] || fail "rumble-login-open takes no arguments"
        rumble_login_open
        ;;
    rumble-login-smoke)
        [[ $# -eq 0 ]] || fail "rumble-login-smoke takes no arguments"
        rumble_login_smoke
        ;;
    rumble-smoke)
        rumble_smoke "$@"
        ;;
    rumble-smoke-once)
        rumble_smoke_once "$@"
        ;;
    rumble-usercard-smoke)
        [[ $# -eq 0 ]] || fail "rumble-usercard-smoke takes no arguments"
        rumble_usercard_smoke
        ;;
    rumble-usercard-smoke-once)
        rumble_usercard_smoke_once "$@"
        ;;
    rumble-reply-smoke)
        [[ $# -eq 0 ]] || fail "rumble-reply-smoke takes no arguments"
        rumble_reply_smoke
        ;;
    rumble-reply-smoke-once)
        rumble_reply_smoke_once "$@"
        ;;
    rumble-lifecycle-smoke)
        [[ $# -eq 0 ]] || fail "rumble-lifecycle-smoke takes no arguments"
        rumble_lifecycle_smoke
        ;;
    rumble-lifecycle-smoke-once)
        rumble_lifecycle_smoke_once "$@"
        ;;
    automatic-routing-smoke)
        [[ $# -eq 0 ]] || fail "automatic-routing-smoke takes no arguments"
        automatic_routing_smoke
        ;;
    automatic-routing-smoke-once)
        automatic_routing_smoke_once "$@"
        ;;
    compact-tab-reveal-smoke)
        [[ $# -eq 0 ]] || fail "compact-tab-reveal-smoke takes no arguments"
        compact_tab_reveal_smoke
        ;;
    compact-tab-reveal-smoke-once)
        compact_tab_reveal_smoke_once "$@"
        ;;
    control-tab-smoke)
        [[ $# -eq 0 ]] || fail "control-tab-smoke takes no arguments"
        control_tab_smoke
        ;;
    control-tab-smoke-once)
        control_tab_smoke_once "$@"
        ;;
    rumble-login-smoke-once)
        rumble_login_smoke_once "$@"
        ;;
    rumble-login-live-once)
        rumble_login_live_once "$@"
        ;;
    shot)
        [[ $# -le 2 ]] || fail "shot accepts at most NAME and WINDOW"
        take_shot "$@"
        ;;
    stop)
        [[ $# -eq 0 ]] || fail "stop takes no arguments"
        stop_session
        ;;
    *)
        fail "unknown command: ${command_name}"
        ;;
esac
