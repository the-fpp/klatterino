ocr_snapshot()
{
    local target="$1"
    local name="$2"
    shot_window "$name" "$target"
    # Control tabs are a sparse strip around a much larger chat surface. Treat
    # the screenshot as sparse text so labels at opposite edges do not get
    # merged into one artificial text block.
    OCR_TEXT="$(tesseract "$LAST_FULL" stdout --psm 11 2>/dev/null || true)"
    OCR_LOWER="${OCR_TEXT,,}"
}

click_ocr_word()
{
    local target="$1"
