list_windows()
{
    require_session
    local ids
    ids="$(inner xdotool search --onlyvisible --name '.*' 2>/dev/null || true)"
    [[ -n "$ids" ]] || fail "no visible windows were found"

    local id title geometry width height x y
    while IFS= read -r id; do
        [[ "$id" =~ ^[0-9]+$ ]] || continue
        title="$(inner xdotool getwindowname "$id" 2>/dev/null || true)"
        title="${title//$'\n'/ }"
        [[ -n "$title" ]] || continue
        geometry="$(inner xdotool getwindowgeometry --shell "$id" 2>/dev/null || true)"
        width=unknown
        height=unknown
        x=unknown
        y=unknown
        while IFS='=' read -r key value; do
            case "$key" in
                WIDTH) width="$value" ;;
                HEIGHT) height="$value" ;;
                X) x="$value" ;;
                Y) y="$value" ;;
            esac
        done <<<"$geometry"
        printf 'id=%s x=%s y=%s width=%s height=%s title=%q\n' \
            "$id" "$x" "$y" "$width" "$height" "$title"
    done <<<"$ids"
}

shot_window()
{
    local name="$1"
    local target="$2"
    [[ "$name" =~ ^[A-Za-z0-9_.-]+$ ]] ||
        fail "shot names may contain only letters, numbers, dot, dash, and underscore"

    local id
    case "$target" in
        main)
            id="$(main_window || true)"
            [[ -n "$id" ]] || fail "the Chatterino main window was not found"
            ;;
        picker)
            id="$(first_window --name '^Open channel$' || true)"
            [[ -n "$id" ]] || fail "the channel picker was not found"
            ;;
        root)
            id=root
            ;;
        *)
            [[ "$target" =~ ^[0-9]+$ ]] || fail "invalid window target: $target"
            id="$target"
            window_exists "$id" || fail "window does not exist: $id"
            ;;
    esac

    mkdir -p "$artifacts_dir"
    local stamp full preview
    stamp="$(date +%Y%m%d-%H%M%S-%3N)"
    full="${artifacts_dir}/${stamp}-${name}.png"
    preview="${artifacts_dir}/${stamp}-${name}.webp"
    inner import -silent -window "$id" "$full"
    magick "$full" -resize '800x800>' -strip -quality 78 "$preview"
    LAST_FULL="$full"
    LAST_PREVIEW="$preview"
}

take_shot()
{
    local name="${1:-manual}"
    local target="${2:-main}"
    shot_window "$name" "$target"
    note "full=${LAST_FULL}"
