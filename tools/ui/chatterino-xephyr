    shot_window "$name" "$target"
    coordinates="$(
        tesseract "$LAST_FULL" stdout --psm 11 tsv 2>/dev/null |
            awk -F '\t' -v pattern="$pattern" '
                tolower($12) ~ pattern {
                    print int($7 + ($9 / 2)), int($8 + ($10 / 2));
                    exit
                }'
    )"
    read -r click_x click_y <<<"$coordinates"
    [[ "$click_x" =~ ^[0-9]+$ && "$click_y" =~ ^[0-9]+$ ]] ||
        fail "could not locate the fixed UI word matching ${pattern}"
    inner xdotool windowactivate --sync "$target" 2>/dev/null
