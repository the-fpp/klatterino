}

rumble_open()
{
    [[ $# -eq 1 ]] || fail "rumble-open requires exactly one public locator"
    local locator="$1"
    [[ ${#locator} -le 2048 ]] || fail "Rumble locator is too long"
    # POSIX argument strings cannot contain NUL; reject the remaining line
    # controls before sending the locator to xdotool.
    [[ "$locator" != *$'\n'* && "$locator" != *$'\r'* ]] ||
        fail "Rumble locator contains a control character"

    local main picker
    main="$(main_window || true)"
    [[ -n "$main" ]] || fail "the Chatterino main window was not found"
    inner xdotool windowactivate --sync "$main" 2>/dev/null
    inner xdotool keyup Control_L 2>/dev/null || true
    inner xdotool keyup Control_R 2>/dev/null || true
    inner xdotool key --clearmodifiers ctrl+t
    inner xdotool keyup Control_L 2>/dev/null || true
    inner xdotool keyup Control_R 2>/dev/null || true

    picker="$(wait_for_window --name '^Open channel$' 200 || true)"
    if [[ -z "$picker" ]]; then
        fail "the channel picker did not open"
    fi

    # The picker has fixed tab geometry at the harness's fixed scale. Clicking
    # the Rumble tab also focuses its locator field.
    # Keep field focus, selection, modifier release, and typing in one xdotool
    # process. Splitting these operations can leave XTEST's Control state
    # visible to the next process, turning a leading T into Ctrl+T.
    inner xdotool \
        windowactivate --sync "$picker" \
        mousemove --sync --window "$picker" 370 40 \
        click 1 \
        sleep 0.1 \
        mousemove --sync --window "$picker" 300 200 \
        click 1 \
        key ctrl+a \
        keyup ctrl \
        sleep 0.1 \
        type --clearmodifiers --delay 5 "$locator"
    inner xdotool key --clearmodifiers Return

    local accepted=false
    for ((i = 0; i < 600; i++)); do
        if ! window_exists "$picker"; then
            accepted=true
            break
        fi
        sleep 0.05
    done

    if [[ "$accepted" != true ]]; then
        shot_window rumble-open-failure "$picker"
        local ocr lower diagnostic=unknown
        ocr="$(tesseract "$LAST_FULL" stdout --psm 6 2>/dev/null || true)"
        lower="${ocr,,}"
        local candidate
        for candidate in header_limit http_failure redirect_rejected \
            embed_schema; do
            if [[ "$lower" == *"$candidate"* ]]; then
                diagnostic="$candidate"
                break
            fi
        done
        if [[ "$diagnostic" == unknown &&
              "$lower" == *"safety limit"* ]]; then
            diagnostic=safety-limit
        elif [[ "$diagnostic" == unknown &&
                ( "$lower" == *"could not"* ||
                  "$lower" == *"error"* ) ]]; then
            diagnostic=visible-error
        fi
        note "rumble-open=rejected diagnostic=${diagnostic}"
        note "preview=${LAST_PREVIEW}"
        return 1
    fi

    inner xdotool windowactivate --sync "$main" 2>/dev/null
    note "rumble-open=accepted"
}

read_window_size()
{
    local id="$1"
    local geometry key value
    geometry="$(inner xdotool getwindowgeometry --shell "$id")"
    WINDOW_WIDTH=""
    WINDOW_HEIGHT=""
    while IFS='=' read -r key value; do
        case "$key" in
            WIDTH) WINDOW_WIDTH="$value" ;;
            HEIGHT) WINDOW_HEIGHT="$value" ;;
        esac
    done <<<"$geometry"
    [[ "$WINDOW_WIDTH" =~ ^[0-9]+$ && "$WINDOW_HEIGHT" =~ ^[0-9]+$ ]]
}

rumble_status()
{
    local main
    main="$(main_window || true)"
    [[ -n "$main" ]] || fail "the Chatterino main window was not found"
    read_window_size "$main" || fail "could not read the Chatterino window size"

    local input_x=$((WINDOW_WIDTH / 2))
    local input_y=$((WINDOW_HEIGHT - 35))
    inner xdotool windowactivate --sync "$main" 2>/dev/null
    inner xdotool mousemove --sync --window "$main" "$input_x" "$input_y"
    inner xdotool click --window "$main" 1
    inner xdotool key --window "$main" --clearmodifiers ctrl+a
    inner xdotool type --window "$main" --clearmodifiers --delay 1 /rumble-status
    inner xdotool key --window "$main" --clearmodifiers Return
    sleep 0.75

    shot_window rumble-status "$main"
    local ocr lower provider=unknown lifecycle=unreadable candidate
    ocr="$(tesseract "$LAST_FULL" stdout --psm 6 2>/dev/null || true)"
    lower="${ocr,,}"
    if [[ "$lower" =~ provider:[[:space:]]*rumble ]]; then
        provider=rumble
    fi
    for candidate in offline connecting connected backoff rate-limited error stopped; do
        if [[ "$lower" =~ state:[[:space:]]*${candidate} ]]; then
            lifecycle="$candidate"
            break
        fi
    done

    note "provider=${provider} state=${lifecycle}"
    note "preview=${LAST_PREVIEW}"
    [[ "$provider" == rumble && "$lifecycle" != unreadable ]]
}

